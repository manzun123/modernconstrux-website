# ===========================================
# Modern Construx Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!
# ===========================================

# ─────────────────────────────────────────────
# SMTP Configuration (Required for Contact Form)
# ─────────────────────────────────────────────
# 
# For Google Workspace / Gmail:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" 
#   4. Use the 16-character password below (not your regular password!)
#
# ─────────────────────────────────────────────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=manuel@modernconstrux.xyz
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# Email Recipients
MAIL_TO=Manuel@modernconstrux.xyz
MAIL_FROM=manuel@modernconstrux.xyz

# ─────────────────────────────────────────────
# AI Visualizer (Optional)
# ─────────────────────────────────────────────
# 
# Get your free API key at: https://huggingface.co/settings/tokens
# Leave empty to disable AI generation (upload/send still works)
#
# ─────────────────────────────────────────────

HF_API_KEY=
